# Flask Environment
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-to-a-super-secret-random-key-in-production

# Database (Leave default to use instance/cybersecurity.db)
DATABASE_PATH=instance/cybersecurity.db

# Optional AI API Key (e.g., Google Gemini API Key for dynamic threat advisor)
# If empty, CyberShield AI will use its intelligent built-in heuristic security engine!
GEMINI_API_KEY=
